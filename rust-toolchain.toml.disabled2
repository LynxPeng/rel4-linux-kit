# Match the rust toolchain with that in the rust-sel4 repository for best results.

[toolchain]
channel = "nightly-2023-08-02"
components = [ "rustfmt", "rust-src" ]


channel = "nightly-2024-12-25"
components = [
  "rustfmt",
  "rust-src",
  "rustc-dev",
  "llvm-tools-preview",
  "rust-analyzer",
]
